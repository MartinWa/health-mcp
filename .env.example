# --- Open Wearables (optional source: set all three to enable) -------------
OW_API_KEY=
OW_USER_ID=
OW_BASE_URL=https://health-api.example.com

# --- strong-data read-only API (optional source) ---------------------------
# Create a token under /tokens/ in the web UI; it is shown once.
STRONG_API_URL=https://workouts.example.com
STRONG_API_TOKEN=
STRONG_CACHE_TTL_HOURS=6
# Optional: the /me id this token must resolve to. A mismatch is reported in
# get_status instead of looking like an empty training history.
STRONG_OWNER_ID=

# --- Local data and cache ---------------------------------------------------
CACHE_DIR=data/cache
CACHE_TTL_HOURS=24
# Mounted read-only in the container; holds profile.yaml and events.csv.
PROFILE_DIR=data/profile

# Optional allowlist. Unset/empty = enable every source whose configuration or
# data files are present.
# SOURCES=openwearables,strong,profile,events
SOURCES=

# Installation timezone. Every date in a response is a local calendar date.
TZ=Europe/Stockholm

# --- HTTP transport (opt-in; required for the container) --------------------
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
# One token per consumer, as name:sha256(token) pairs, comma-separated.
# Generate a token:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Hash it:           printf %s "$TOKEN" | sha256sum
MCP_BEARER_TOKENS=
# Single-consumer alias, hashed to the "default" name. HTTP mode fails closed
# when both this and MCP_BEARER_TOKENS are empty.
MCP_BEARER_TOKEN=

# --- Tool output caps -------------------------------------------------------
DEFAULT_MAX_POINTS=200
DEFAULT_PAGE_LIMIT=50

LOG_LEVEL=INFO
